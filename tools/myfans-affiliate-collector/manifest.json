{
  "manifest_version": 3,
  "name": "MyFans Affiliate Catalog Local Collector",
  "version": "0.6.0",
  "description": "Safely collects catalog text and runs a bounded user-started official-UI affiliate generation pilot.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://www.affiliate.myfans.jp/*"
  ],
  "action": {
    "default_title": "MyFans catalog collector",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.affiliate.myfans.jp/affiliates/search*",
        "https://www.affiliate.myfans.jp/affiliates/generated*",
        "https://www.affiliate.myfans.jp/affiliates/url*"
      ],
      "js": [
        "src/export-artifacts.js",
        "src/affiliate-generation-core.js",
        "src/collector-core.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
