# 公開URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（必須）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# 管理者（必須）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-password

# サーバー間認証（本番必須）
CRON_SECRET=generate-a-long-random-secret
X_REPLY_API_KEY=generate-another-long-random-secret
INGEST_API_KEY=generate-another-long-random-secret

# X自動収集（未使用なら空欄可）
X_BEARER_TOKEN=
X_COLLECTION_QUERY=品番 OR 女優 -is:retweet lang:ja

# AI抽出（未使用なら空欄可）
OPENAI_API_KEY=
AI_EXTRACTION_MODEL=gpt-5.4-mini

# FANZA API（CSV運用のみなら空欄可）
FANZA_API_ID=
FANZA_AFFILIATE_ID=
